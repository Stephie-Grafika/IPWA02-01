<?xml version='1.0' encoding='UTF-8' ?>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:h="http://xmlns.jcp.org/jsf/html"
      xmlns:f="http://xmlns.jcp.org/jsf/core">
	<h:head>
		<title>CO2-Emission aller Länder</title>
	</h:head>
	<h:body>
		
		<img src="assets/img/Logo.png" width="200px"/>
		<h:graphicImage url=""/>
		<h1>CO2-Emission aller Länder</h1>
		
		<h:outputText value="#{co2emission.land}"></h:outputText>

		<h:dataTabel var="landEmission" value="#{co2emmision.land}" styleClass="co2tabelle">
			<h:column>
				<f:facet name="header"></f:facet>
				<h:outputText value="#{co2emission.land}"/>
			</h:column>
			<h:column><h:outputText value="#{co2emission.land}"/></h:column>
			<h:column><h:outputText value="#{co2emission.flagge}"/></h:column>
			<h:column><h:outputText value="#{co2emission.emission2020}"/></h:column>
			<h:column><h:outputText value="#{co2emission.emission2021}"/></h:column>
			<h:column><h:outputText value="#{co2emission.emission2022}"/></h:column>
			<h:column><h:outputText value="#{co2emission.emission2023}"/></h:column>
		</h:dataTabel>
	</h:body>
</html>